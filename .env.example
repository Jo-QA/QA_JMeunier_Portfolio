# Documentation only: not loaded automatically. Set OS environment variables.
# These credentials are PUBLIC DEMO DATA displayed by SauceDemo, not secrets.
SD_BASE_URL=https://www.saucedemo.com/
SD_USERNAME=standard_user
SD_PASSWORD=secret_sauce
SD_LOCKED_USERNAME=locked_out_user
SD_HEADLESS=true
SD_TIMEOUT=10
# Optional: full paths when Selenium Manager cannot access the network.
# SD_BROWSER_BINARY=
# SD_DRIVER_PATH=
# SE_CACHE_PATH=
# SE_AVOID_STATS=true
